{
  "manifest_version": 2,
  "name": "Keyhop",
  "version": "0.1.0",
  "description": "Keyboard-driven browsing: link hints, vim-style scrolling, tab control and a command bar.",

  "browser_specific_settings": {
    "gecko": {
      "id": "keyhop@uttam.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },

  "permissions": ["storage", "sessions", "search"],

  "background": {
    "scripts": ["src/background.js"],
    "persistent": false
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
